{
      // Custom tags used by ESPHome: without these the YAML extension
    // reports "Unresolved tag" on !lambda, !secret, !include...
    "yaml.customTags": [
        "!lambda scalar",
        "!secret scalar",
        "!include scalar",
        "!include mapping",
        "!include_dir_named scalar",
        "!include_dir_list scalar",
        "!include_dir_merge_list scalar",
        "!include_dir_merge_named scalar",
        "!extend scalar",
        "!remove scalar",
        "!remove mapping",
        "!env_var scalar"
    ]
}