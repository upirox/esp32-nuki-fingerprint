{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		// Open the project YAML files as plain YAML, not as Home Assistant
		// configuration (Studio Code Server default), so the tags below apply
		"files.associations": {
			"*.yaml": "yaml"
		},
		// Custom tags used by ESPHome (!lambda, !secret, !include...)
		"yaml.customTags": [
			"!lambda scalar",
			"!secret scalar",
			"!include scalar",
			"!include mapping",
			"!include_dir_named scalar",
			"!include_dir_list scalar",
			"!include_dir_merge_list scalar",
			"!include_dir_merge_named scalar",
			"!extend scalar",
			"!remove scalar",
			"!remove mapping",
			"!env_var scalar"
		]
	}
}